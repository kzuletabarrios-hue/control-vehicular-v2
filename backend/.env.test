# ================================================================
# backend/.env.test -- credenciales de la base de datos LOCAL de
# pruebas (NUNCA producción). Se versiona a propósito en git: son
# credenciales fijas de un Postgres local (no Supabase-hospedado,
# ver nota más abajo), sin ningún dato real ni valor de negocio --
# perder o exponer este archivo no representa ningún riesgo.
#
# NO renombrar a ".env" ni copiar sus valores a backend/.env: ese
# archivo apunta a producción real (Supabase, host
# aws-1-sa-east-1.pooler.supabase.com) y así debe seguir para que la
# app en ejecución normal siga funcionando contra el CEDI real.
#
# Cómo se generó / cómo levantar este entorno desde cero:
# ver la sección "Entorno de pruebas" en el resumen de la tarea de
# María (2026-09-14) o correr:
#   bash scripts/dev_test_db.sh reset
#
# ── Por qué esto NO es el stack completo de `supabase start` ──────
# Esta máquina de desarrollo no tiene Docker Desktop ni WSL2
# instalados (`supabase start` requiere Docker; falló con
# "docker: command not found (podman also not found)"). En su lugar,
# se usa una instancia de PostgreSQL 18 standalone, autocontenida en
# .devstack/pgdata/ (mismos binarios de PostgreSQL ya instalados en
# esta máquina, cluster nuevo y aislado, sin tocar el servicio de
# Windows "postgresql-x64-18" que ya corría en el puerto 5432 antes
# de esta tarea). Las 46 migraciones de supabase/migrations/ y
# supabase/seed.sql se validaron contra esta base con
# `supabase db reset --db-url ...` y con psql -f directo. No emula
# GoTrue/PostgREST/Storage/Studio -- el backend de esta app nunca los
# usa (se conecta directo a Postgres vía SQLAlchemy), así que no hace
# falta para test de backend. Si en el futuro se instala Docker
# Desktop, se puede migrar a `supabase start` real: bastaría con
# actualizar DATABASE_URL al connection string que imprima esa CLI
# (típicamente puerto 54322) y borrar este archivo de notas.
# ================================================================

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/control_vehicular_test?sslmode=disable

SECRET_KEY=test-only-jwt-secret-NUNCA-usar-en-produccion-1234567890
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# Supabase Storage: NO disponible en este entorno local (no hay stack
# Docker corriendo, ver nota arriba). Cualquier test que dependa de
# subida real de fotos a Storage debe mockear/saltar estas variables;
# se dejan vacías a propósito para que fallen de forma explícita y
# obvia si algo las usa sin mock, en vez de silenciosamente pegarle a
# producción.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
